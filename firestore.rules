rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    // - Anyone authenticated can view user profiles
    // - Authenticated users can create or update profile data
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Skills Collection
    // - Authenticated users can read and manage skills
    match /skills/{skillId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Chats Collection
    // - Authenticated participants can read and write chat threads & messages
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();

      // Messages Subcollection
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Bookings Collection
    // - Authenticated users can view bookings and schedule/manage sessions
    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated();
    }

    // Ratings Collection
    // - Authenticated users can read and write reviews & ratings
    match /ratings/{ratingId} {
      allow read, write: if isAuthenticated();
    }
  }
}
